# サブPC（自宅LAN内の常時稼働Linux）用のエージェント設定。
# /etc/ops-dashboard-host-stats.env として配置し、chmod 600 / root 所有にする。

OPS_DASHBOARD_URL=https://admin.gucchii.com

# ダッシュボード側の HOST_STATS_TOKEN と同じ値（1Password の apps/ops-dashboard/host-stats-token）
HOST_STATS_TOKEN=

HOST_STATS_ID=subpc
HOST_STATS_LABEL=サブPC

# df -h を見て、監視したいマウントポイントに合わせる
HOST_STATS_DISK_PATHS=/

# サブPCは外形監視の対象になっていないため、意味のあるものは入れておく。
# dbus・polkit・systemd-* 等は、それが死ぬ状況ではホストごと壊れていて
# エージェントも送信できない（OFFLINE表示になる）ため入れていない。
# ssh（OpenSSH）は入れていない。サブPCへは Tailscale SSH（tailscaled）で入っており、
# sshd を止めても困らないため、止めたときに赤いバッジが出ないようにしている（#315）
HOST_STATS_SERVICES=mysql,tailscaled,cron,unattended-upgrades

# 実行結果を見る systemd timer（#75）。`systemctl is-active` では oneshot のジョブが
# 成功したのか失敗したのかを区別できないため、タイマーは services とは別に指定する。
# `<ユーザー>@` を前置するとユーザー単位（`~/.config/systemd/user/`）のユニットを指す。
# aide の Zaim 取得はセッション切れで自動回復できず、人が気づくまで毎時失敗し続けるため入れている
HOST_STATS_TIMERS=guchi@aide-zaim-sync,guchi@aide-zaim-keep-alive

# アプリ別のメモリ・ディスク使用量（#226）。サブPCの ~/apps は作業用のチェックアウトと worktree が
# 並ぶ場所で、アプリの稼働状況とは対応しないうえ、node_modules を抱えた worktree の du が重いため空にしている
HOST_STATS_APPS_ROOT=

# 場所別のディスク使用量（#652）。アプリの置き場の外で膨らみ、ルートFSを90%まで押し上げた場所を挙げる。
# 測るのは ops-dashboard-host-stats-disk.timer（1時間ごと）で、毎分の送信は結果を読むだけ。
# ~/apps は上の HOST_STATS_APPS_ROOT と同じ理由（worktree の du が重い）で入れていない
HOST_STATS_DISK_WATCH_PATHS=/tmp/node-compile-cache,/home/guchi/.npm,/tmp/claude-1000

HOST_STATS_TIMEOUT=
