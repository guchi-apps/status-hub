# VPS（ダッシュボード自身が動いているホスト）用のエージェント設定。
# /etc/ops-dashboard-host-stats.env として配置し、chmod 600 / root 所有にする。

# ダッシュボードは同じマシンで動いているため、外部を経由せず直接叩く
OPS_DASHBOARD_URL=http://localhost:3110

# ダッシュボード側の HOST_STATS_TOKEN と同じ値（1Password の apps/ops-dashboard/host-stats-token）
HOST_STATS_TOKEN=

HOST_STATS_ID=vps
HOST_STATS_LABEL=VPS

HOST_STATS_DISK_PATHS=/

# Uptime Kuma の HTTP 監視と重複しないものだけを選んでいる。
#   pm2-github-user … 落ちるとNext.jsアプリが全滅する。Kumaでは15件が一斉に赤くなるだけで原因が分からない
#   mariadb         … HTTPの外形からは落ちたことが分かりにくい
#   cron            … HTTPの口が無い。止まるとバックアップ等が静かに止まる
#   fail2ban        … HTTPの口が無い
# apache2 と各Next.jsアプリはUptime Kumaが直接見ているため入れていない。
# vps-status-api / uptime-kuma-backup-receiver は user systemd（github-user）で、
# root の systemctl からは見えないため、Uptime Kuma 側にHTTPモニターとして追加する。
HOST_STATS_SERVICES=pm2-github-user,mariadb,cron,fail2ban

# 実行結果を見る systemd timer（#75）。VPS側に監視したい定期ジョブはまだ無いため空にしている。
# 空のときは項目ごと送らず、ダッシュボードは「定期ジョブ」を表示しない
HOST_STATS_TIMERS=

# アプリ別のメモリ・ディスク使用量（#226）。各アプリは github-user の ~/apps/<アプリ> に置かれている。
# メモリは作業ディレクトリがこの配下にあるプロセスをアプリごとに合計し、ディスクは1時間ごとに du で測る
HOST_STATS_APPS_ROOT=/home/github-user/apps

HOST_STATS_TIMEOUT=
