# Pi Zero W（自宅LAN内・SwitchBot の BLE 取得専用機）用のエージェント設定（#581）。
# /etc/ops-dashboard-host-stats.env として配置し、chmod 600 / root 所有にする。
#
# Pi は BLE 取得と、この軽量な状態送信だけを動かす。StatusHub の画面・ビルド・AI処理は載せない。
# Tailscale は前提にせず、Pi から StatusHub へ HTTPS で送る（push 型。VPS からは Pi へ届かないため）。

OPS_DASHBOARD_URL=https://admin.gucchii.com

# ダッシュボード側の HOST_STATS_TOKEN と同じ値（1Password の apps/ops-dashboard/host-stats-token）
HOST_STATS_TOKEN=

HOST_STATS_ID=pi0w
HOST_STATS_LABEL=Pi Zero W

HOST_STATS_DISK_PATHS=/

# BLE 取得が依存する bluetooth と、LCD/LED 表示の room-panel。
# room-panel は常駐（Type=simple）なので services で死活を見る
HOST_STATS_SERVICES=bluetooth,room-panel

# SwitchBot 取得とエアコン取得の定期ジョブ（5分ごとの oneshot）。成功・失敗・停止を見る。
# どちらも OnUnitActiveSec のタイマーで、Raspbian 10 の systemd 241 は list-timers の JSON 出力を
# 持たないため「次回予定」は出ない（未実行の判定はできない）。止まったことはセンサーの鮮度で拾う
HOST_STATS_TIMERS=switchbot-co2,aircon-myroom

# センサーごとの最終成功時刻（switchbot_to_myroom.py が書く）。リビング・屋外を別々に判定する
HOST_STATS_SENSOR_STATUS_FILE=/var/lib/myroom-pi/sensor-status.tsv

# アプリ別の集計（/proc 全走査と du）は Pi では重いので行わない
HOST_STATS_APPS_ROOT=

# Wi-Fi 越しの送信なので、VPS・サブPCより少し長めにとる
HOST_STATS_TIMEOUT=20
