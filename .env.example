# Supabase Auth（複数アプリ共通のプロジェクトを使用。db-console と同一プロジェクトの値を再利用する。
# Google Provider の設定はSupabaseダッシュボード側で行う。Publishable keyはフロントに公開してよい値）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログイン許可メールアドレス（カンマ区切り、複数可）。
# ログインの判定には使わない（#489。判定は共通アクセス設定のDB）。アクセス設定DBを初めて作るときに、
# ここのメールをStatusHubの管理者として取り込むだけ（移行用）。取り込み後に変えても反映されない
ALLOWED_EMAILS=

# 共通アクセス設定（#489。docs/access-control.md）
# このDBの環境（production / development。未設定は development）。DBに記録され、食い違うと全拒否になる。
# 本番は deploy.yml が production を渡す
ACCESS_ENVIRONMENT=
# DBの保存先（未設定時は ./.data/access.sqlite）。秘密情報の値は入らない（トークンはハッシュのみ）
ACCESS_DB_PATH=

# UptimeRobot（Read-Only APIキー）
UPTIMEROBOT_READ_ONLY_KEY=

# Uptime Kuma（公開ステータスページ経由でのモニター取得）
UPTIMEKUMA_BASE_URL=
UPTIMEKUMA_DASHBOARD_SLUG=

# Uptime Kuma の管理者アカウント。監視タブと POST /api/uptime-kuma/monitors からの
# モニター登録に使う（Kumaにはモニターを作るREST APIが無く、管理者としてログインした
# socket.io セッションからしか作成できないため）。未設定なら登録機能は無効になり、
# 「モニター追加」はKumaの画面を開くリンクに戻る。2要素認証が有効なアカウントでは使えない
UPTIMEKUMA_USERNAME=
UPTIMEKUMA_PASSWORD=

# POST /api/uptime-kuma/monitors をサーバー間から叩くための固定トークン。32文字以上の
# ランダム文字列を設定する。読み取り用の OPS_API_TOKEN とは分けている（読み取りのつもりで
# 配ったトークンで監視設定を書き換えられないようにするため）。未設定ならこのAPIは
# ログインセッションからしか使えない
UPTIMEKUMA_ADMIN_TOKEN=

# ホスト（VPS・サブPC）のステータス表示。各ホストのエージェント（scripts/host-stats/）と
# 共有する固定トークン。32文字以上のランダム文字列を設定する
# （未設定なら受信は常に401になり、一度も受信していなければセクションも表示されない）
HOST_STATS_TOKEN=
# 画面に並べる順番（ホスト識別子をカンマ区切り）。ここに無いホストは後ろへ回り、識別子順に並ぶ
HOST_STATS_ORDER=
# 最終受信からこの秒数を過ぎたらオフライン扱いにする（未設定時は300）
HOST_STATS_OFFLINE_AFTER_SECONDS=
# グラフに残す履歴の長さ（時間、未設定時は24）
HOST_STATS_HISTORY_HOURS=
# 受信データの保存先（未設定時は ./.data/host-stats。この下にホスト識別子ごとのディレクトリを作る）
HOST_STATS_DATA_DIR=

# 定期ジョブ（systemd timer）の異常判定（#75）。監視するユニットはホスト側の
# HOST_STATS_TIMERS で指定する
# 次回予定からこの秒数を過ぎても実行されていなければ「未実行」とみなす（未設定時は3600）
HOST_STATS_TIMER_GRACE_SECONDS=
# 何回続けて失敗したら通知するか（未設定時は1＝1回目から通知する）。
# 数えるのは受信回数ではなく実行回数
HOST_STATS_TIMER_FAILURE_THRESHOLD=

# （廃止予定）Signalyへのログイン通知はコードから読まれなくなった（#516）
SIGNALY_LOGIN_WEBHOOK_URL=
# Signalyへの異常通知（定期ジョブの失敗・復旧。未設定なら通知しない）。
# 日常的に流れるログイン通知に埋もれないよう、チャンネルを分ける
SIGNALY_ALERT_WEBHOOK_URL=

# AIトークン使用状況（Claude / ChatGPT）
# Claude: ~/.claude/.credentials.json の claudeAiOauth.refreshToken
# （`claude setup-token` の長期トークンは user:profile スコープが付かず使えない）
ANTHROPIC_OAUTH_REFRESH_TOKEN=
# ChatGPT: ~/.codex/auth.json の tokens.refresh_token / tokens.account_id
OPENAI_CHATGPT_REFRESH_TOKEN=
OPENAI_CHATGPT_ACCOUNT_ID=

# 課金プランの表示名（任意）。通常は各APIから自動取得するため未設定でよく、
# 設定した場合だけ表示名の上書きとして使われる
CLAUDE_PLAN_NAME=
CHATGPT_PLAN_NAME=

# GitHubの制限表示（未設定なら GitHub セクションを表示しない）
# 課金レポートのエンドポイントは fine-grained PAT に非対応のため、classic PAT を使う。
# 必要なスコープは repo（private リポジトリの一覧取得用）と read:org
GH_USAGE_TOKEN=
# 集計対象の Organization 名
GH_USAGE_ORG=

# Actions無料枠の上限（分/月、任意）。未設定なら組織のプランから自動で決まる
# （Free 2000 / Team 3000 / Enterprise 50000。プランを判別できないときだけ 2000）。
# プランと違う値を分母にしたい場合だけ設定する
GH_ACTIONS_MINUTES_LIMIT=
# GitHub使用状況のキャッシュ秒数（未設定時は300）
GH_USAGE_CACHE_SECONDS=

# 無料枠を消費したかは「使用時点で非公開だったか」で決まるため、リポジトリの公開状態を
# 取得のたびに記録する。その保存先（未設定時は ./.data/github-repo-visibility.json）。
# 記録されるのは切り替えた時刻ではなく、切り替え後に初めてダッシュボードを開いた時刻
GH_USAGE_VISIBILITY_PATH=
# 記録が始まる前の期間の補正（任意）。「このリポジトリはこの日時より前は非公開だった」を
# `リポジトリ名:日時` のカンマ区切りで与える。記録が貯まれば不要なので、対象の月が過ぎたら消す
# 例: GH_USAGE_PRIVATE_UNTIL=db-console:2026-08-19,ops-dashboard:2026-08-18
GH_USAGE_PRIVATE_UNTIL=

# 使用状況のキャッシュ秒数（未設定時は300）と、更新したOAuthトークンの保存先（未設定時は ./.data/ai-usage-tokens.json）
AI_USAGE_CACHE_SECONDS=
AI_USAGE_STATE_PATH=
# 枠の使い切り実績の保存先（未設定時は ./.data/ai-usage-windows.json）
AI_USAGE_HISTORY_PATH=

# TypeSafe AI（Jev）の呼出元が集計した実測使用量を読むAPI。両方未設定ならTypeSafeのカードは表示しない。
# TypeSafeの公開APIはアカウント残高・上限を返さないため、入力トークン数と単価ベースの概算金額を表示する。
TYPESAFE_USAGE_URL=
TYPESAFE_USAGE_TOKEN=

# アプリ別のAI利用（#431）の連携先を、issue-deckなどのAIエージェントから更新する専用トークン。
# 32文字以上のランダム文字列を設定する。OPS_API_TOKENは連携先へ送る読み取り用なので流用しない。
# 未設定でもログイン画面からは編集できるが、サーバー間の自動変更は受け付けない。
AI_APP_USAGE_SOURCES_WRITE_TOKEN=

# 連携先URLに許すホストの追加分（カンマ区切り）。gucchii.com配下とループバックは常に許可する。
# `example.com` は完全一致、`*.example.com` はサブドメイン。OPS_API_TOKENの送信先になるため最小限にする。
AI_APP_USAGE_ALLOWED_HOSTS=

# 1Passwordのレート制限の表示（未設定なら 1Password セクションを表示しない）。
# 取得には 1Password CLI（op）がサーバーに入っている必要がある
OP_SERVICE_ACCOUNT_TOKEN=
# op の実行パス（任意）。PATH に無い場所へ入れた場合だけ設定する
OP_CLI_PATH=
# 1Password使用状況のキャッシュ秒数（未設定時は300）
OP_USAGE_CACHE_SECONDS=

# iPhoneウィジェット（Scriptable）から /api/claude-usage を叩くための固定トークン。
# 32文字以上のランダム文字列を設定する（未設定なら常に401を返す）
WIDGET_TOKEN=

# 同一VPS上のAIDE（MCPサーバー）から読み取りAPIを参照するための固定トークン。
# 32文字以上のランダム文字列を設定する
# （未設定ならトークン経路は無効になり、読み取りAPIはログインセッション必須のままになる）
OPS_API_TOKEN=

# AIDE（MCPサーバー）の動作状況をAIDEタブに出すための固定トークン（#237）。
# AIDE側の AIDE_STATUS_SECRET と同じ値にする。OPS_API_TOKEN（AIDEがこちらを読む向き）とは別の値にする。
#
# 正はissue-deckの共有トークンAPI（下のSHARED_TOKEN_API_SECRET・ISSUE_DECK_URL、#444）で、
# 起動時にそちらから取得する。この変数は取得に失敗したとき・issue-deckが未設定のときの
# フォールバックとしてのみ使う（移行が済んだら削除予定）。両方とも未設定ならAIDEタブも
# 上部のチップも出さない
AIDE_STATUS_TOKEN=
# dotが報告した作業の状況（#575）を読むためのトークン。AIDE側の AIDE_WORK_REPORTS_READ_SECRET と同じ値にする。
# AIDE_STATUS_TOKEN・OPS_API_TOKENとは別の値にする（流用すると読める範囲が黙って広がる）。未設定なら
# 「dotの作業状況」の節を出さない
AIDE_WORK_REPORTS_TOKEN=
# AIDEの接続先（任意）。未設定なら同じVPS上の http://127.0.0.1:3114
AIDE_BASE_URL=

# issue-deckの共有トークンAPI（#444）。1Passwordから複製せず、実行時にissue-deckから
# トークンを読む「方式A」の最初の適用先がAIDE_STATUS_TOKEN。取得結果はメモリに10分キャッシュし、
# 失敗時は直前の値を使い続ける。どちらか一方でも未設定なら、この経路は使わず
# 上のAIDE_STATUS_TOKENへフォールバックする
SHARED_TOKEN_API_SECRET=
# IssueDeckの保護対象更新専用。読み取りキーと異なる値を両サーバーだけに配備する。
SHARED_TOKEN_WRITE_SECRET=
ISSUE_DECK_URL=

# AI利用枠のプッシュ通知（#263）に使うVAPID鍵の組。`npx web-push generate-vapid-keys` で作る。
# 未設定ならヘッダーの通知ボタンを出さず、通知も送らない。作り直すと登録済みの端末へは届かなくなる
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# モデル単価表の定期チェック（#497）。未設定なら毎週月曜05:00（Asia/Tokyo）に本番だけで実行する
# MODEL_PRICE_WATCH_DAY=1
# MODEL_PRICE_WATCH_HOUR=5
# MODEL_PRICE_WATCH_TZ=Asia/Tokyo
# MODEL_PRICE_WATCH_ENABLED=
